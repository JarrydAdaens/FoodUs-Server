Desktop.ini

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
uv.lock

# .NET build output
[Bb]in/
[Oo]bj/
*.user
.vs/

# Secrets — real runtime values live on the droplet, never in this repository.
# Only appsettings.Production.template.json (blank values) is committed.
appsettings.Production.json
appsettings.*.local.json
*.secrets.json
.env

# Deployment target for the publish script: host name, SSH user, and key path are private.
scripts/publish.local.psd1

# Local SQLite databases
*.db
*.db-wal
*.db-shm

# Harness module runtime output — tracked files define a module, ignored files
# preserve local durability (see harness/README-HARNESS.md).
harness/*/runs/
harness/*/state/
harness/*/last-run/
harness/*/captures/
harness/*/reports/
