{
  // TEMPLATE — committed with blank values only. Public mechanism, private values.
  //
  // On the droplet, copy this file to appsettings.Production.json beside the published
  // relay and fill in the values, or set the equivalent environment variables instead:
  //
  //   Kestrel__Endpoints__Http__Url   e.g. http://127.0.0.1:5000
  //   Relay__DatabasePath             e.g. /var/lib/foodus-relay/relay.db
  //
  // Environment variables win over this file, which wins over appsettings.json. There is no
  // custom loader; this is ASP.NET's standard override chain.
  //
  // appsettings.Production.json is git-ignored and must never be committed. Never put a real
  // domain, endpoint address, key, or credential in THIS file.

  "Kestrel": {
    "Endpoints": {
      "Http": {
        // Must remain a loopback address. The relay is never internet-facing; the reverse
        // proxy in front of it terminates TLS and forwards to this port.
        "Url": ""
      }
    }
  },

  "Relay": {
    // Absolute path to the relay's SQLite database on the host.
    "DatabasePath": ""
  }
}
